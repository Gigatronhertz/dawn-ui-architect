# ── Database (Turso) ──────────────────────────────────────────────────────────
# Get from: turso.tech — create a database and run:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── WhatsApp (Whisper360) ─────────────────────────────────────────────────────
# The only WhatsApp integration in the app — used by the payment-reminder
# chase-up (services/reminders.js) and the "your plan is ready" notification
# (routes/api.js). The old Zavu integration (outbound client, inbound
# /webhook signature verification, and the bot/ conversation flows it drove)
# was removed; that whole product surface is retired.
WA_DISPLAY_NUMBER=         # e.g. 2348012345678 — the number shown to users
# Get from: Whisper360 console → Developer tools → API keys.
WHISPER360_API_KEY=
WHISPER360_BASE_URL=       # Optional — defaults to https://api.whisper360.io
# One template per message shape — WhatsApp templates can't branch on
# content. Create drafts with `node backend/scripts/createReminderTemplates.js`,
# then approve each in the console before enabling the whatsapp channel below.
WHISPER360_TEMPLATE_NUDGE=      # Optional — defaults to karije_reminder_nudge
WHISPER360_TEMPLATE_CHASE=      # Optional — defaults to karije_reminder_chase
WHISPER360_TEMPLATE_FINAL=      # Optional — defaults to karije_reminder_final
WHISPER360_TEMPLATE_PLAN_READY=      # Optional — defaults to karije_plan_ready
WHISPER360_TEMPLATE_EVENT_REGISTERED= # Optional — defaults to karije_event_registered

# ── Reminders ──────────────────────────────────────────────────────────────────
# Channels to try in order, stopping at the first that lands.
# WhatsApp leads; falls back to email until the templates above are approved.
REMINDER_CHANNELS=whatsapp,email

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=     # https://your-render-url.onrender.com/payment/confirm

# ── Google Maps (Geocoding + Places + Distance Matrix) ────────────────────────
GOOGLE_API_KEY=

# ── Amadeus (flights) ─────────────────────────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── Booking.com via RapidAPI ──────────────────────────────────────────────────
RAPIDAPI_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Public URL of this backend. Reminder emails build their Pay now link from it,
# so a wrong value here mails out a button nobody can click.
BACKEND_URL=https://dawn-ui-architect.onrender.com
PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
