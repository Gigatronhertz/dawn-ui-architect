# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────────────
# Get these from: developers.facebook.com → your app → WhatsApp → API Setup
WA_PHONE_ID=               # Phone Number ID (not the display number)
WA_TOKEN=                  # Permanent System User access token
WA_VERIFY_TOKEN=           # Any random string you choose — used to verify the webhook URL

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=       # sk_live_xxx  (use sk_test_xxx for dev)
PAYSTACK_CALLBACK_URL=     # https://yourdomain.com/payment/confirm

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
