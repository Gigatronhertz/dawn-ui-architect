# ── Database (Turso) ──────────────────────────────────────────────────────────
# Get from: turso.tech — create a database and run:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── WhatsApp outbound (Zavu) ──────────────────────────────────────────────────
# Get from: docs.zavu.dev → dashboard → API keys.
# A sender must also be configured in the Zavu dashboard, or every send fails
# with "No default sender configured".
ZAVU_API_KEY=
ZAVU_SENDER_ID=            # Optional — pins sends to one sender when the account has several
ZAVU_BASE_URL=             # Optional — defaults to https://api.zavu.dev/v1
# Approved template name. Reminders go out days after someone joins, so the 24h
# free-form window is shut and WhatsApp requires a template. Unset → email only.
ZAVU_REMINDER_TEMPLATE=
ZAVU_TEMPLATE_LANG=        # Optional — defaults to en

# ── WhatsApp inbound (Zavu webhook) ───────────────────────────────────────────
# Per-sender webhook secret from the Zavu dashboard, used to verify the
# X-Zavu-Signature header. Unset means every inbound message is rejected —
# the endpoint fails closed rather than letting strangers drive the bot.
ZAVU_WEBHOOK_SECRET=
# Register your endpoint against the sender in Zavu: https://<host>/webhook
WA_DISPLAY_NUMBER=         # e.g. 2348012345678 — the number shown to users

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=     # https://your-render-url.onrender.com/payment/confirm

# ── Google Maps (Geocoding + Places + Distance Matrix) ────────────────────────
GOOGLE_API_KEY=

# ── Amadeus (flights) ─────────────────────────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── Booking.com via RapidAPI ──────────────────────────────────────────────────
RAPIDAPI_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
