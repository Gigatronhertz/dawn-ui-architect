# ── Database (Turso) ──────────────────────────────────────────────────────────
# Get from: turso.tech — create a database and run:
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=

# ── WhatsApp outbound (Zavu) ──────────────────────────────────────────────────
# Get from: docs.zavu.dev → dashboard → API keys.
# A sender must also be configured in the Zavu dashboard, or every send fails
# with "No default sender configured".
ZAVU_API_KEY=
ZAVU_SENDER_ID=            # Optional — pins sends to one sender when the account has several
ZAVU_BASE_URL=             # Optional — defaults to https://api.zavu.dev/v1
# Approved template name. Reminders go out days after someone joins, so the 24h
# free-form window is shut and WhatsApp requires a template. Unset → email only.
ZAVU_REMINDER_TEMPLATE=
ZAVU_TEMPLATE_LANG=        # Optional — defaults to en

# ── WhatsApp inbound (Zavu webhook) ───────────────────────────────────────────
# Per-sender webhook secret from the Zavu dashboard, used to verify the
# X-Zavu-Signature header. Unset means every inbound message is rejected —
# the endpoint fails closed rather than letting strangers drive the bot.
ZAVU_WEBHOOK_SECRET=
# Register your endpoint against the sender in Zavu: https://<host>/webhook
WA_DISPLAY_NUMBER=         # e.g. 2348012345678 — the number shown to users

# ── WhatsApp reminders (Whisper360) ───────────────────────────────────────────
# Used only by the payment-reminder chase-up (services/reminders.js) — a
# separate provider from the Zavu integration above, which everything else
# (bot flows, webhook.js) still uses.
# Get from: Whisper360 console → Developer tools → API keys.
WHISPER360_API_KEY=
WHISPER360_BASE_URL=       # Optional — defaults to https://api.whisper360.io
# One template per reminder tone — WhatsApp templates can't branch on
# content. Create drafts with `node backend/scripts/createReminderTemplates.js`,
# then approve each in the console before enabling the whatsapp channel below.
WHISPER360_TEMPLATE_NUDGE= # Optional — defaults to karije_reminder_nudge
WHISPER360_TEMPLATE_CHASE= # Optional — defaults to karije_reminder_chase
WHISPER360_TEMPLATE_FINAL= # Optional — defaults to karije_reminder_final

# ── Reminders ──────────────────────────────────────────────────────────────────
# Channels to try in order, stopping at the first that lands. Email leads;
# swap to whatsapp,email once the three templates above are approved.
REMINDER_CHANNELS=email,whatsapp

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get from: aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get from: dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=     # https://your-render-url.onrender.com/payment/confirm

# ── Google Maps (Geocoding + Places + Distance Matrix) ────────────────────────
GOOGLE_API_KEY=

# ── Amadeus (flights) ─────────────────────────────────────────────────────────
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ── Booking.com via RapidAPI ──────────────────────────────────────────────────
RAPIDAPI_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# Public URL of this backend. Reminder emails build their Pay now link from it,
# so a wrong value here mails out a button nobody can click.
BACKEND_URL=https://dawn-ui-architect.onrender.com
PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
